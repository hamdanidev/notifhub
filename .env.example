SERVICE_NAME=notifhub
NOTIFHUB_MODE=development
DATABASE_URL="postgresql://notifhub:notifhub_pass@localhost:5432/notifhub_dev?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_API_KEY=dev-api-key-change-in-prod
DEFAULT_TENANT_ID=default
DEFAULT_LOCALE=id
IDEMPOTENCY_TTL_DAYS=7
RETENTION_DAYS=90
TEMPLATE_TEST_SEND_RETENTION_DAYS=180
TEMPLATE_AUDIT_RETENTION_DAYS=730
# Retensi AdminAuditEvent (hari); 0 menonaktifkan cleanup.
ADMIN_AUDIT_RETENTION_DAYS=730
INGEST_MAX_PAYLOAD_BYTES=65536
TEMPLATE_MAX_PAYLOAD_BYTES=1048576
TEMPLATE_IMAGE_DIR=var/template-images
TEMPLATE_IMAGE_MAX_BYTES=5242880
TEMPLATE_IMAGE_BASE_URL=
INGEST_RATE_LIMIT_PER_KEY=100
INGEST_RATE_LIMIT_WINDOW_SECONDS=60
PROVIDER_RATE_LIMIT_EMAIL_PER_SEC=10
PROVIDER_RATE_LIMIT_WHATSAPP_PER_SEC=5
RECIPIENT_THROTTLE_WINDOW_SECONDS=60
CORS_ORIGINS=*
FAIL_MODE_ON_REDIS_DOWN=closed
SUBSCRIBER_JWT_SECRET=dev-subscriber-jwt-secret-change-me-32chars
SSE_HEARTBEAT_INTERVAL_SECONDS=25
SSE_REPLAY_BUFFER_SECONDS=300
ADMIN_EMAIL=admin@notifhub.local
ADMIN_PASSWORD_HASH='$2b$10$REPLACE_WITH_GENERATED_HASH'
ADMIN_JWT_EXPIRES_IN=1h
ADMIN_JWT_SECRET=dev-admin-jwt-secret-change-me-32chars

# Platform admin (opsional: isi keduanya atau kosongkan keduanya)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD_HASH=
CATCH_ALL_RECIPIENT=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@notifhub.local"
SWAGGER_BASIC_AUTH_USER=
SWAGGER_BASIC_AUTH_PASS=
WEBHOOK_SIGNING_SECRET=dev-webhook-signing-secret-change-me-32

WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_CATCH_ALL_RECIPIENT=
# WAHA hanya dipakai bila WHATSAPP_PROVIDER=waha (self-hosted, tidak resmi).
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_WEBHOOK_HMAC_KEY=
