{
  "name": "notifhub-console",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:platform": "vite --mode platform",
    "build": "npm run typecheck && node scripts/prepare-build.mjs && npm run build:tenant && npm run build:platform",
    "build:tenant": "vite build",
    "build:platform": "vite build --mode platform && node scripts/finalize-platform-build.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --outDir dist/tenant",
    "preview:tenant": "vite preview --outDir dist/tenant",
    "preview:platform": "vite preview --mode platform --outDir dist/platform"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@notifhub/js": "file:../packages/js-sdk",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^8.21.3",
    "bootstrap": "^5.3.9",
    "date-fns": "^4.4.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
