# Contoh konfigurasi untuk docker-compose.prod.yml.
# Salin ke .env.prod, ganti semua CHANGE_ME, dan jangan commit file hasilnya.
#
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# --- mode & runtime ---------------------------------------------------------
NOTIFHUB_MODE=production
NODE_ENV=production
SERVICE_NAME=notifhub
PORT=3000
LOG_LEVEL=info

# --- postgres (dipakai compose untuk service postgres + DATABASE_URL) -------
# Hindari karakter khusus (@ : / #) pada password agar URL tetap valid.
POSTGRES_USER=notifhub
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=notifhub

# --- console ----------------------------------------------------------------
# URL API yang dipakai browser; diisi saat build image console.
CONSOLE_API_URL=http://localhost:3000
# Origin yang diizinkan backend. Tambahkan origin console platform (port 8081 di smoke stack).
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
# URL publik console platform; dipakai nginx tenant untuk redirect /platform/*.
PLATFORM_CONSOLE_URL=http://localhost:8081

# --- ingest & delivery ------------------------------------------------------
SERVICE_API_KEY=CHANGE_ME_at_least_16_chars
DEFAULT_TENANT_ID=default
DEFAULT_LOCALE=id
IDEMPOTENCY_TTL_DAYS=7
RETENTION_DAYS=90
TEMPLATE_TEST_SEND_RETENTION_DAYS=180
TEMPLATE_AUDIT_RETENTION_DAYS=730
# Retensi AdminAuditEvent (hari); 0 menonaktifkan cleanup.
ADMIN_AUDIT_RETENTION_DAYS=730
INGEST_MAX_PAYLOAD_BYTES=65536
TEMPLATE_MAX_PAYLOAD_BYTES=1048576
TEMPLATE_IMAGE_DIR=/app/var/template-images
TEMPLATE_IMAGE_MAX_BYTES=5242880
TEMPLATE_IMAGE_BASE_URL=
INGEST_RATE_LIMIT_PER_KEY=100
INGEST_RATE_LIMIT_WINDOW_SECONDS=60
PROVIDER_RATE_LIMIT_EMAIL_PER_SEC=10
PROVIDER_RATE_LIMIT_WHATSAPP_PER_SEC=5
RECIPIENT_THROTTLE_WINDOW_SECONDS=60
FAIL_MODE_ON_REDIS_DOWN=closed
SSE_HEARTBEAT_INTERVAL_SECONDS=25
SSE_REPLAY_BUFFER_SECONDS=300

# --- auth & signing (semua minimal 32 karakter) -----------------------------
SUBSCRIBER_JWT_SECRET=CHANGE_ME_at_least_32_characters_long_secret
ADMIN_EMAIL=admin@example.com
# Hasil `npm run admin:hash-password "password"`; pertahankan kutip tunggal.
ADMIN_PASSWORD_HASH='$2b$10$CHANGE_ME'
ADMIN_JWT_SECRET=CHANGE_ME_at_least_32_characters_long_secret
ADMIN_JWT_EXPIRES_IN=1h
WEBHOOK_SIGNING_SECRET=CHANGE_ME_at_least_32_characters_long_secret

# --- platform admin (opsional; isi keduanya atau kosongkan) -----------------
# Email ini tidak boleh sama dengan ADMIN_EMAIL.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD_HASH=

# --- email (wajib di luar development) --------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# --- swagger (wajib dilindungi di luar development) -------------------------
SWAGGER_BASIC_AUTH_USER=docs
SWAGGER_BASIC_AUTH_PASS=CHANGE_ME

# --- whatsapp (opsional) ----------------------------------------------------
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
