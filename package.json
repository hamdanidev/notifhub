{
  "name": "notifhub-service",
  "version": "0.11.0",
  "description": "NotifHub — general-purpose multi-channel notification service with SDK-first integration",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "typecheck": "tsc --noEmit",
    "test:db:setup": "node scripts/test-db-setup.mjs",
    "pretest:e2e": "npm run test:db:setup",
    "test:e2e": "jest --config test/jest-e2e.json",
    "test:unit": "jest --config test/jest-unit.json",
    "ci": "node scripts/ci.mjs",
    "sdk:build": "npm run build --workspace @notifhub/js",
    "sdk:typecheck": "npm run typecheck --workspace @notifhub/js",
    "sdk:test": "npm run test --workspace @notifhub/js",
    "react:build": "npm --prefix packages/react run build",
    "react:typecheck": "npm --prefix packages/react run typecheck",
    "react:test": "npm --prefix packages/react run test",
    "console:install": "npm --prefix console install",
    "console:dev": "npm --prefix console run dev",
    "console:build": "npm --prefix console run build",
    "console:typecheck": "npm --prefix console run typecheck",
    "admin:hash-password": "node -e \"require('bcrypt').hash(process.argv[1], 10).then(console.log)\"",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:reset": "docker compose -f docker-compose.dev.yml down -v",
    "openapi:export": "node scripts/export-openapi.mjs",
    "dev:subscriber-token": "node --env-file=.env scripts/dev-subscriber-token.mjs",
    "verify:preferences": "node --env-file=.env scripts/verify-preferences.mjs",
    "docs:check": "node scripts/check-docs-links.mjs",
    "sdk:go:generate": "cd sdk/go && go generate ./...",
    "sdk:go:test": "cd sdk/go && go test ./..."
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^4.0.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express-basic-auth": "^1.2.1",
    "handlebars": "^4.7.10",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.5.0",
    "opossum": "^10.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
