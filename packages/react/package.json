{
  "name": "@notifhub/react",
  "version": "0.2.0",
  "description": "React bindings for NotifHub in-app notifications (built on @notifhub/js)",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18 <19",
    "react-dom": ">=18 <19"
  },
  "dependencies": {
    "@notifhub/js": "file:../js-sdk"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
