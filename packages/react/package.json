{
  "name": "@notifhub/react",
  "version": "0.3.0",
  "description": "React bindings for NotifHub in-app notifications (built on @notifhub/js)",
  "license": "UNLICENSED",
  "author": {
    "name": "hamdanidev",
    "url": "https://github.com/hamdanidev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamdanidev/notifhub.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/hamdanidev/notifhub/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/hamdanidev/notifhub/issues"
  },
  "keywords": [
    "notifications",
    "in-app",
    "react",
    "sdk",
    "notifhub"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18 <19",
    "react-dom": ">=18 <19"
  },
  "dependencies": {
    "@notifhub/js": "^0.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
