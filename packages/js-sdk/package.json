{
  "name": "@notifhub/js",
  "version": "0.3.0",
  "description": "Headless TypeScript SDK for NotifHub in-app notifications (fetch-based SSE)",
  "license": "UNLICENSED",
  "author": {
    "name": "hamdanidev",
    "url": "https://github.com/hamdanidev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamdanidev/notifhub.git",
    "directory": "packages/js-sdk"
  },
  "homepage": "https://github.com/hamdanidev/notifhub/tree/main/packages/js-sdk#readme",
  "bugs": {
    "url": "https://github.com/hamdanidev/notifhub/issues"
  },
  "keywords": [
    "notifications",
    "in-app",
    "sse",
    "sdk",
    "notifhub"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
