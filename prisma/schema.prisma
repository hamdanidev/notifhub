// Prisma schema for NotifHub.
// Phase 1: schema only for most models. Workers, providers, admin API and topics API are later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  inapp
  email
  whatsapp
  sms
}

enum Status {
  pending
  sent
  failed
  read
  skipped
}

enum OverallStatus {
  pending
  partial
  sent
  failed
}

enum TemplateStatus {
  draft
  published
}

enum TemplateFormat {
  text
  html
  markdown
}

enum TemplateDirection {
  auto
  ltr
  rtl
}

enum TemplateAuditAction {
  created
  draft_updated
  updated
  published
  deactivated
  activated
  cloned
  rolled_back
  test_sent
}

enum TenantStatus {
  active
  suspended
}

model Tenant {
  id          String       @id
  name        String
  status      TenantStatus @default(active)
  suspendedAt DateTime?    @db.Timestamptz
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz

  notifications         Notification[]
  notificationTemplates NotificationTemplate[]
  templateLayouts       TemplateLayout[]
  templateThemes        TemplateTheme[]
  templatePartials      TemplatePartial[]
  templateAuditEvents   TemplateAuditEvent[]
  templateTestSends     TemplateTestSend[]
  templateImages        TemplateImage[]
  preferences           NotificationPreference[]
  billingEvents         BillingEvent[]
  subscribers           Subscriber[]
  topics                Topic[]
  apiKeys               ApiKey[]
  adminUsers            AdminUser[]

  @@index([status])
  @@index([createdAt])
}

model Notification {
  id                     String        @id @default(uuid())
  idempotencyKey         String
  idempotencyExpiresAt   DateTime
  tenantId               String        @default("default")
  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  templateKey            String
  payload                Json
  priority               Int           @default(3)
  overallStatus          OverallStatus @default(pending)
  targetType             String        @default("recipients")
  targetSnapshot         Json?
  resendOfNotificationId String?
  resendMode             String?
  groupAckRequired       Boolean       @default(false)
  groupAckDeadline       DateTime?     @db.Timestamptz
  groupAcknowledgedAt    DateTime?     @db.Timestamptz
  groupAcknowledgedBy    String?
  createdAt              DateTime      @default(now()) @db.Timestamptz
  updatedAt              DateTime      @updatedAt @db.Timestamptz
  deletedAt              DateTime?     @db.Timestamptz

  recipients       NotificationRecipient[]
  billingEvents    BillingEvent[]
  deliveryAttempts DeliveryAttempt[]

  @@unique([tenantId, idempotencyKey])
  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([overallStatus])
  @@index([idempotencyExpiresAt])
  @@index([priority, overallStatus])
  @@index([resendOfNotificationId])
}

model NotificationRecipient {
  id                 BigInt       @id @default(autoincrement())
  notificationId     String
  notification       Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipientId        String
  channel            Channel
  status             Status       @default(pending)
  attempts           Int          @default(0)
  lastError          String?
  providerName       String?
  providerMessageId  String?
  templateId         String?
  templateVersion    Int?
  templateResolvedAt DateTime?    @db.Timestamptz
  sentAt             DateTime?    @db.Timestamptz
  deliveredAt        DateTime?    @db.Timestamptz
  readAt             DateTime?    @db.Timestamptz
  acknowledgedAt     DateTime?    @db.Timestamptz

  @@unique([notificationId, recipientId, channel])
  @@index([recipientId, status])
  @@index([status])
  @@index([templateId])
}

model NotificationTemplate {
  id                 String            @id @default(uuid())
  tenantId           String            @default("default")
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  key                String
  channel            Channel
  locale             String            @default("id")
  subject            String?
  preheader          String?
  body               String
  format             TemplateFormat    @default(text)
  direction          TemplateDirection @default(auto)
  version            Int               @default(1)
  revision           Int               @default(0)
  status             TemplateStatus    @default(published)
  active             Boolean           @default(true)
  strictVariables    Boolean           @default(false)
  variables          Json?
  sampleData         Json?
  builderData        Json?
  layoutId           String?
  layout             TemplateLayout?   @relation(fields: [layoutId], references: [id])
  themeId            String?
  theme              TemplateTheme?    @relation(fields: [themeId], references: [id])
  fallbackProvider   String?
  fallbackChannel    Channel?
  publishedAt        DateTime?         @db.Timestamptz
  publishedByAdminId String?
  createdAt          DateTime          @default(now()) @db.Timestamptz
  updatedAt          DateTime          @updatedAt @db.Timestamptz

  partials    TemplatePartialLink[]
  auditEvents TemplateAuditEvent[]
  testSends   TemplateTestSend[]

  @@unique([tenantId, key, channel, locale, version])
  @@index([tenantId, key, channel, locale, active, status])
  @@index([tenantId, status, updatedAt])
  @@index([layoutId])
  @@index([themeId])
}

model TemplateLayout {
  id               String   @id @default(uuid())
  tenantId         String   @default("default")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  key              String
  version          Int
  name             String
  content          String
  createdByAdminId String?
  createdAt        DateTime @default(now()) @db.Timestamptz

  templates NotificationTemplate[]

  @@unique([tenantId, key, version])
  @@index([tenantId, key, version])
}

model TemplateTheme {
  id               String   @id @default(uuid())
  tenantId         String   @default("default")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  key              String
  version          Int
  name             String
  tokens           Json
  createdByAdminId String?
  createdAt        DateTime @default(now()) @db.Timestamptz

  templates NotificationTemplate[]

  @@unique([tenantId, key, version])
  @@index([tenantId, key, version])
}

model TemplatePartial {
  id               String   @id @default(uuid())
  tenantId         String   @default("default")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  key              String
  version          Int
  name             String
  content          String
  createdByAdminId String?
  createdAt        DateTime @default(now()) @db.Timestamptz

  links TemplatePartialLink[]

  @@unique([tenantId, key, version])
  @@index([tenantId, key, version])
}

model TemplatePartialLink {
  templateId String
  partialId  String
  template   NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  partial    TemplatePartial      @relation(fields: [partialId], references: [id])

  @@id([templateId, partialId])
  @@index([partialId])
}

model TemplateAuditEvent {
  id              BigInt              @id @default(autoincrement())
  tenantId        String              @default("default")
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  templateId      String
  templateVersion Int
  action          TemplateAuditAction
  actorAdminId    String?
  actorEmail      String?
  note            String?
  metadata        Json?
  createdAt       DateTime            @default(now()) @db.Timestamptz

  template NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([tenantId, templateId, createdAt])
  @@index([tenantId, createdAt])
  @@index([createdAt])
}

model TemplateTestSend {
  id                 String   @id @default(uuid())
  tenantId           String   @default("default")
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  templateId         String
  templateVersion    Int
  channel            Channel
  recipientMasked    String
  recipientHash      String
  requestKey         String?
  status             String
  providerName       String?
  providerMessageId  String?
  errorCode          String?
  errorMessage       String?
  requestedByAdminId String?
  createdAt          DateTime @default(now()) @db.Timestamptz

  template NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([tenantId, requestKey])
  @@index([tenantId, createdAt])
  @@index([templateId, createdAt])
  @@index([requestedByAdminId, createdAt])
  @@index([createdAt])
}

model TemplateImage {
  id               String   @id @default(uuid())
  tenantId         String   @default("default")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  mimeType         String
  size             Int
  width            Int
  height           Int
  storageKey       String   @unique
  checksum         String
  createdByAdminId String?
  createdAt        DateTime @default(now()) @db.Timestamptz

  @@index([tenantId, createdAt])
}

model NotificationPreference {
  id              String   @id @default(uuid())
  tenantId        String   @default("default")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipientId     String
  channel         Channel
  enabled         Boolean  @default(true)
  quietHoursStart String?
  quietHoursEnd   String?
  timezone        String   @default("Asia/Jakarta")
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  @@unique([tenantId, recipientId, channel])
}

model DeliveryEvent {
  id             BigInt   @id @default(autoincrement())
  notificationId String
  recipientId    String
  channel        Channel
  providerName   String
  eventType      String
  rawPayload     Json
  occurredAt     DateTime @default(now()) @db.Timestamptz

  @@index([notificationId])
  @@index([providerName, occurredAt])
}

model DeliveryAttempt {
  id             BigInt       @id @default(autoincrement())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipientId    String
  channel        Channel
  attemptNumber  Int
  providerName   String
  status         String
  errorName      String?
  errorMessage   String?
  errorStack     String?
  durationMs     Int
  occurredAt     DateTime     @default(now()) @db.Timestamptz

  @@index([notificationId])
  @@index([status, occurredAt])
  @@index([providerName, occurredAt])
}

model BillingEvent {
  id             BigInt       @id @default(autoincrement())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  tenantId       String       @default("default")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  eventType      String
  occurredAt     DateTime     @default(now()) @db.Timestamptz

  @@index([tenantId, occurredAt])
  @@index([notificationId])
}

model Subscriber {
  id         String   @id @default(uuid())
  tenantId   String   @default("default")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  externalId String
  email      String?
  phone      String?
  locale     String?
  timezone   String   @default("Asia/Jakarta")
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@unique([tenantId, externalId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
}

model Topic {
  id          String   @id @default(uuid())
  key         String
  tenantId    String   @default("default")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  displayName String?
  mode        String   @default("push")
  isTimeBound Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  subscribers TopicSubscriber[]

  @@unique([tenantId, key])
  @@index([tenantId, createdAt])
}

model TopicSubscriber {
  id          String    @id @default(uuid())
  topicId     String
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  recipientId String
  addedAt     DateTime  @default(now()) @db.Timestamptz
  expiresAt   DateTime? @db.Timestamptz

  @@unique([topicId, recipientId])
  @@index([expiresAt])
}

model ApiKey {
  id                  String    @id @default(uuid())
  name                String
  keyHash             String    @unique
  tenantId            String    @default("default")
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  allowedOrigins      String[]  @default([])
  subscriberJwtSecret String?
  active              Boolean   @default(true)
  lastUsedAt          DateTime? @db.Timestamptz
  createdAt           DateTime  @default(now()) @db.Timestamptz
  updatedAt           DateTime  @updatedAt @db.Timestamptz

  @@index([tenantId])
}

model AdminUser {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  /// Hash env terakhir yang diterapkan bootstrap; membedakan rotasi env dari perubahan password UI.
  bootstrapPasswordHash String?
  role                 String    @default("tenant_admin")
  tenantId             String?
  tenant               Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  active               Boolean   @default(true)
  lastLoginAt          DateTime? @db.Timestamptz
  tokenVersion         Int       @default(0)
  createdAt            DateTime  @default(now()) @db.Timestamptz
  updatedAt            DateTime  @updatedAt @db.Timestamptz

  @@index([tenantId])
  @@index([role])
}

/// Append-only audit trail for platform-lane mutations. No FK on purpose: entries must stay
/// readable after an admin or tenant is deleted. Never store secrets here.
model PlatformAuditEvent {
  id           BigInt   @id @default(autoincrement())
  actorAdminId String
  actorEmail   String
  action       String
  tenantId     String?
  targetType   String
  targetId     String
  metadata     Json?
  ip           String?
  requestId    String?
  occurredAt   DateTime @default(now()) @db.Timestamptz

  @@index([tenantId, occurredAt])
  @@index([actorAdminId, occurredAt])
  @@index([action, occurredAt])
}
